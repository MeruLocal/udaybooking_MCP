{
  "name": "udaybooking-mcp-server",
  "version": "1.0.0",
  "description": "Official Udaybooking MCP server: read-only access to udaybooking.com docs, guides, pricing and FAQs, over stdio or Streamable HTTP.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MeruLocal/udaybooking_MCP.git"
  },
  "homepage": "https://github.com/MeruLocal/udaybooking_MCP#readme",
  "bugs": {
    "url": "https://github.com/MeruLocal/udaybooking_MCP/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20.10.0"
  },
  "bin": {
    "udaybooking-mcp-server": "dist/index.js",
    "udaybooking-mcp-http": "dist/http.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "scripts",
    "server.json",
    "README.md",
    ".env.example"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node scripts/check-versions.mjs && vitest run",
    "check:versions": "node scripts/check-versions.mjs",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "inspect": "npm run build && npx @modelcontextprotocol/inspector node dist/index.js",
    "prepublishOnly": "npm run build",
    "smoke": "npm run build && node scripts/smoke.mjs",
    "start:http": "node dist/http.js",
    "dev:http": "tsx watch src/http.ts",
    "smoke:http": "node scripts/smoke-http.mjs",
    "inspect:http": "npm run build && npx @modelcontextprotocol/inspector"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "udaybooking",
    "scheduling",
    "claude"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.4",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.4"
  }
}
