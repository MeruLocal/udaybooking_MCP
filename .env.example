###############################################################################
# udaybooking-mcp-server (official Udaybooking MCP server) — example configuration
#
# Copy to .env and adjust only if you need to. Every value below is a default;
# the server runs correctly with no .env file at all.
#
# THERE ARE NO CREDENTIALS HERE, AND NONE ARE NEEDED.
# udaybooking.com publishes no authenticated API, so this server never holds a
# password, cookie, API key or session token. If a future version of this file
# ever asks you for a secret, treat that as a red flag and check why.
###############################################################################

# Origin to read from. Change only to point at a mirror or staging copy.
# Only udaybooking.com, www.udaybooking.com and this URL's own host can be
# fetched; every other host (including other udaybooking.com subdomains) is
# refused in code, and redirects are checked hop by hop before they are followed.
UDAYBOOKING_BASE_URL=https://udaybooking.com

# Per-request timeout, in milliseconds (1000-120000).
UDAYBOOKING_REQUEST_TIMEOUT_MS=15000

# Retry attempts after the first try, for transient failures only (0-5).
# udaybooking.com intermittently drops connections, so retries matter.
UDAYBOOKING_MAX_RETRIES=2

# Base delay for exponential backoff between retries, in milliseconds (50-10000).
UDAYBOOKING_RETRY_BASE_DELAY_MS=800

# Minimum gap between the start of consecutive requests, in milliseconds (0-5000).
#
# Keep this. Bursting ~50 requests at udaybooking.com's edge caused it to stop
# accepting connections from this client for several minutes, which breaks every
# tool. Spacing requests is what keeps the server usable. Raise it if you still
# see connect timeouts; lower it only against a mirror you control.
UDAYBOOKING_MIN_REQUEST_INTERVAL_MS=250

# How long a fetched page stays usable in memory, in milliseconds (0-86400000).
# The site's sitemaps declare changefreq=monthly, so 15 minutes is conservative.
# Set to 0 to disable caching entirely (not recommended — it multiplies load).
UDAYBOOKING_CACHE_TTL_MS=900000

# Maximum cached pages before least-recently-used entries are evicted (16-5000).
UDAYBOOKING_CACHE_MAX_ENTRIES=400

# Simultaneous in-flight requests to the origin (1-8). Low on purpose.
UDAYBOOKING_MAX_CONCURRENCY=2

# Maximum pages fetched when warming one market's search index (5-200).
# Bounds both first-search latency and load on the origin. Sections are indexed
# in priority order (docs, guides, help, pricing, ...), so documentation is
# never dropped in favour of marketing pages when the budget binds.
UDAYBOOKING_INDEX_MAX_PAGES=40

# How this client identifies itself to udaybooking.com. The default carries the
# package version and the repository URL as the contact point.
UDAYBOOKING_USER_AGENT=udaybooking-mcp-server/1.0.0 (+https://github.com/MeruLocal/udaybooking_MCP)

# Largest response body read from the origin, in bytes (10000-100000000).
# A larger or endless response is refused instead of being buffered in memory.
UDAYBOOKING_MAX_RESPONSE_BYTES=5000000

# Log threshold: debug | info | warn | error | silent.
# Logs always go to stderr — stdout is reserved for MCP protocol frames.
UDAYBOOKING_LOG_LEVEL=info

###############################################################################
# HTTP transport (npm run start:http only — ignored by the stdio entry point)
###############################################################################

# TCP port for the Streamable HTTP transport. PORT is honoured as a fallback.
UDAYBOOKING_HTTP_PORT=3004

# Interface to bind. Loopback by default, deliberately.
#
# This server has NO AUTHENTICATION. It only exposes public, read-only content
# and holds no credentials, so that is not a data risk — but binding 0.0.0.0
# would let anyone on the network use your machine to fetch udaybooking.com,
# under your IP and your rate-limit budget. Only widen this behind a reverse
# proxy that terminates auth.
UDAYBOOKING_HTTP_HOST=127.0.0.1

# Comma-separated browser origins allowed to call the HTTP endpoint.
#
# DNS-rebinding protection: empty means no browser origin is accepted, while
# ordinary MCP clients and curl (which send no Origin header) still work. Set
# this only if a browser-based client genuinely needs access.
# Example: UDAYBOOKING_HTTP_ALLOWED_ORIGINS=http://localhost:6274
UDAYBOOKING_HTTP_ALLOWED_ORIGINS=

# Idle time after which an HTTP session is closed, in milliseconds (10s-24h).
# Needed because closing a client does not end its server session, and a
# crashed client never sends DELETE — without this, sessions accumulate.
UDAYBOOKING_HTTP_SESSION_IDLE_TTL_MS=1800000

# Requests per minute per client IP (every path except /health). 0 disables.
UDAYBOOKING_HTTP_RATE_LIMIT_PER_MIN=60

# Most concurrent sessions; a further initialize gets 503 + Retry-After.
UDAYBOOKING_HTTP_MAX_SESSIONS=100

# Host header names this server answers (DNS-rebinding guard). Any other Host
# gets 403. Behind Apache, keep ProxyPreserveHost on or add the forwarded host.
UDAYBOOKING_HTTP_ALLOWED_HOSTS=localhost,127.0.0.1,[::1],mcp.udaybooking.com

# Number of trusted proxy hops in front of this server, used to pick the client
# IP from X-Forwarded-For (counted from the right). 0 = socket address.
# Cloudflare then Apache: 2 (or use Apache mod_remoteip and set 1). Without a
# proxy keep 0, or clients could pick their own rate-limit bucket.
TRUST_PROXY=0

# Public base URL advertised by /.well-known/mcp.json. Never derived from
# X-Forwarded-* headers. Production: https://mcp.udaybooking.com
PUBLIC_BASE_URL=
